# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional settings
# GEMINI_MODEL=gemini-flash-latest
# MAX_INPUT_CHARS=400000
# MAX_DOWNLOAD_MB=50
# CROSSREF_MAILTO=you@example.com

# Model used for quick background calls such as title and author extraction.
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# Maximum number of PDF pages to extract.
# MAX_PAGES=300
# Optional Semantic Scholar API key; leave empty to use unauthenticated lookups.
SEMANTIC_SCHOLAR_API_KEY=
# Alternative Gemini key used when GOOGLE_API_KEY is unset.
GEMINI_API_KEY=
